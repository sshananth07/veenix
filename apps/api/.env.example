NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3100
MONGODB_URI=mongodb://veenix:veenix-dev-only@127.0.0.1:27017/veenix?authSource=admin&directConnection=true
REDIS_URL=redis://127.0.0.1:6380
AUTH_JWKS_URL=http://localhost:3100/api/auth/jwks
AUTH_ISSUER=http://localhost:3100
AUTH_AUDIENCE=veenix-api
SIGNUP_MODE=open
LIVE_TICKET_SECRET=<random>
CRON_SECRET=<random>
FIELD_ENCRYPTION_KEY=<random>
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=veenix-dev
S3_ACCESS_KEY_ID=veenix
S3_SECRET_ACCESS_KEY=veenix-dev-secret
S3_FORCE_PATH_STYLE=true
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Veenix <no-reply@veenix.local>"
# Assistant (plan 12). Leave the key empty to run without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
# WhatsApp (plan 14). Leave empty to run without it; the webhook then answers 503.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# The Veenix number staff message, digits with country code (e.g. 60123456789).
WHATSAPP_NUMBER=
# Voice note transcription.
STT_API_KEY=
